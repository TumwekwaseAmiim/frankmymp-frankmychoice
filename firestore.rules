rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;}
  match /admins/{id} {allow read: if request.auth != null && request.auth.uid == id;allow write: if false;}
  match /posts/{id} {allow read: if resource.data.status == 'published' || admin();allow create,update,delete: if admin();}
  match /comments/{id} {allow read: if resource.data.status == 'approved' || admin();allow write: if false;}
  match /publicStats/{id} {allow read: if true;allow write: if false;}
  match /dailyStats/{id} {allow read: if true;allow write: if false;}
  match /rateLimits/{id} {allow read,write: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}
